# Kopyalayıp .env olarak kaydedin. .env git'e girmez.
# Değişiklikten sonra geliştirme sunucusunu yeniden başlatın.

# Veritabanı. Boşsa yerel dosya kullanılır: file:data/trai-pro.db
# Uzak libSQL (ör. Turso): libsql://<veritabanı>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Google ile giriş. İkisi de boşsa Google düğmesi "kullanılamıyor" mesajı verir.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sitenin dışarıdan görünen adresi (sonunda / olmadan). Boşsa isteğin adresi kullanılır.
# Google'daki "Authorized redirect URI" ile aynı kökte olmalı: <PUBLIC_URL>/auth/google/callback
PUBLIC_URL=

# Site bir proxy/yük dengeleyici arkasındaysa "on": deneme sınırı için istemci IP'si
# X-Forwarded-For başlığından okunur. Proxy yokken açmayın; başlık sahtelenebilir.
TRUST_PROXY=

# Üretimde demo ödemeleri açmak için "on". Gerçek ödeme sağlayıcısı bağlanınca kaldırılacak.
DEMO_PAYMENTS=
