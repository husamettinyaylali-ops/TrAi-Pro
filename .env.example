# Kopyalayıp .env olarak kaydedin. .env git'e girmez.
# Yeni eklenen değerler geliştirmede hemen okunur; var olan bir değeri değiştirirseniz sunucuyu yeniden başlatın.

# Veritabanı. Boşsa yerel dosya kullanılır: file:data/trai-pro.db
# Uzak libSQL (ör. Turso): libsql://<veritabanı>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Google ile giriş. İkisi de boşsa Google düğmesi "kullanılamıyor" mesajı verir.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sitenin dışarıdan görünen adresi (sonunda / olmadan), ör. https://trai.example
# Yayında ZORUNLU: e-postadaki doğrulama/sıfırlama bağlantıları yalnız buradan kurulur
# (istekteki Host başlığına güvenilmez). Geliştirmede boşsa isteğin adresi kullanılır.
# Google'daki "Authorized redirect URI" ile aynı kökte olmalı: <PUBLIC_URL>/auth/google/callback
PUBLIC_URL=

# E-posta (SMTP). SMTP_HOST ve EMAIL_FROM boşsa geliştirmede e-postalar gönderilmez,
# data/outbox klasörüne dosya olarak yazılır. Yayında ikisi de zorunludur.
# Port 587 STARTTLS, 465 doğrudan TLS (465'te ya da SMTP_SECURE=on ile).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Gönderen adresi; alan adınızın SPF/DKIM kayıtları bu sağlayıcıya izin vermeli.
EMAIL_FROM="TrAi Pro <no-reply@alanadiniz.com>"

# Gerçek ses üretimi (ElevenLabs). Boşsa Stüdyo demo kipinde çalışır (tarayıcı önizlemesi).
# Anahtar: elevenlabs.io > Settings > API Keys. Ses klonlama ücretli plan (Starter+) ister.
ELEVENLABS_API_KEY=
# Model; boşsa eleven_multilingual_v2 (Türkçeyi kendisi algılar).
ELEVENLABS_MODEL=
# Kullanıcılara sunulacak hazır seslerin kimlikleri (virgülle). Boşsa hesaptaki tüm hazır sesler.
ELEVENLABS_VOICE_IDS=
# Üretilen ses dosyalarının klasörü; boşsa data/audio.
AUDIO_DIR=

# USDT (BEP20) ile bakiye yükleme. Kendi cüzdan adresiniz (0x…, BSC ağı). Boşsa yöntem kapalı.
# DİKKAT: Başka bir sitenin ekranındaki adresi asla yazmayın; ödemeler o adrese gider.
USDT_BEP20_ADDRESS=
# İşlem doğrulaması için BSC JSON-RPC adresi; boşsa herkese açık BNB Chain düğümü.
BSC_RPC_URL=
# Bakiyeye yazmadan önce beklenecek blok onayı; boşsa 12.
USDT_BEP20_CONFIRMATIONS=

# Binance Pay ile bakiye yükleme. Üçü de doluysa yöntem açılır.
# Kendi Binance kimliğiniz (Pay ID, yalnız rakam); kullanıcılara gösterilir.
# DİKKAT: Başka bir sitenin ekranındaki kimliği asla yazmayın; ödemeler o hesaba gider.
BINANCE_PAY_ID=
# Aynı hesabın API anahtarı: yalnız "Enable Reading" izni verin, IP kısıtlaması ekleyin.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Boşsa https://api.binance.com
BINANCE_API_URL=

# PayPal ve kartla bakiye yükleme (PayPal REST uygulaması). İkisi de doluysa yöntem açılır.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" değilse sandbox (test) ortamı kullanılır.
PAYPAL_ENV=
# Webhook kimliği: incelemeye düşüp sonradan tamamlanan ödemeler için. Boşsa webhook kapalı.
# PayPal'da https://<alan-adınız>/webhooks/paypal adresine PAYMENT.CAPTURE.COMPLETED olayını ekleyin.
PAYPAL_WEBHOOK_ID=

# Site bir proxy/yük dengeleyici arkasındaysa "on": deneme sınırı için istemci IP'si
# X-Forwarded-For başlığından okunur. Proxy yokken açmayın; başlık sahtelenebilir.
TRUST_PROXY=

# Üretimde demo ödemeleri açmak için "on". Gerçek ödeme sağlayıcısı bağlanınca kaldırılacak.
DEMO_PAYMENTS=
