# Caddy, DOMAIN için Let's Encrypt sertifikasını kendisi alır ve yeniler.
# İstemciden gelen X-Forwarded-For başlığına güvenmez, kendisi yazar
# (uygulamada TRUST_PROXY=on güvenle kullanılır).
{$DOMAIN} {
	encode zstd gzip
	# Tarayıcı bu alan adına bir yıl boyunca yalnız HTTPS ile bağlanır.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy app:3000
}
